PORT=3001

# AI Chat - Groq primary, Gemini automatic fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=20000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000

# Real-time Weather - OpenWeatherMap (FREE, 1M calls/month)
# Get key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Frontend URL for CORS (set in production)
FRONTEND_URL=
