PORT=3001

# AI Chat - Groq primary (rapide + 120B), Gemini en secours automatique.
# AI_PRIMARY=groq (defaut) | gemini  -> inverse l'ordre des fournisseurs sans toucher au code.
AI_PRIMARY=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=20000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
# gemini-3.x sont des modeles "thinking" : marge de tokens reservee au raisonnement
# en plus de la reponse (evite les reponses vides / tronquees -> bascule Groq inutile)
GEMINI_THINKING_HEADROOM=6000

# Traduction : via le LLM (Gemini/Groq). L'ancienne API HuggingFace
# (api-inference.huggingface.co / NLLB) est hors service -> plus utilisee.
# HF_API_KEY reste utile si un backend MMS-TTS le requiert.
HF_API_KEY=

# Voix locale (MMS-TTS). Vide = desactive -> le navigateur lit via Web Speech.
# Pointer vers un backend TTS fonctionnel qui accepte {inputs} et renvoie de
# l'audio ; {lang} est remplace par le code MMS (wol, hau, bam...).
# ex: MMS_TTS_URL=https://mon-tts.example/facebook/mms-tts-{lang}
MMS_TTS_URL=

# Real-time Weather - OpenWeatherMap (FREE, 1M calls/month)
# Get key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Frontend URL for CORS (set in production)
FRONTEND_URL=
